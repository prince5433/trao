# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/interview-prep-kit

# Server
PORT=4000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated browser origins allowed for CORS/cookies (no trailing slash)
CLIENT_ORIGIN=http://localhost:3000

# LLM (Groq free tier by default; swap provider/model via env)
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
# Optional OpenAI-compatible base URL override
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Fetch / crawl
ALLOW_LOCALHOST_FETCH=true
FETCH_TIMEOUT_MS=15000
CRAWL_MAX_PAGES=6
CRAWL_RATE_MS=400
COVERAGE_MAX_PASSES=3

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
